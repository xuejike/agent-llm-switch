{
  "name": "llm-config-manager",
  "version": "0.1.0",
  "private": true,
  "description": "LLM 配置管理器：集中维护供应商中立的 Provider 配置并一键分发到多个本地 AI Agent",
  "author": {
    "name": "jike.xue",
    "email": "245674286@qq.com"
  },
  "license": "MIT",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "dist": "pnpm build && electron-builder",
    "dist:dir": "pnpm build && electron-builder --dir",
    "dist:win": "pnpm build && electron-builder --win --x64 --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --x64 --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report e2e/.report",
    "test:live": "vitest run src/main/services/modelDiscovery.live.test.ts",
    "test:e2e:live": "playwright test live-api.e2e.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "electron:install": "node scripts/install-electron.cjs",
    "postinstall": "node scripts/install-electron.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "~7.37.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@iarna/toml": "^2.2.5",
    "antd": "^5.21.6",
    "js-yaml": "^5.5.0",
    "react": "~18.3.1",
    "react-dom": "~18.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  }
}
